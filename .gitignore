# ============================================================
# SOPI · archivos que NO se suben a GitHub
# ============================================================

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.code-workspace

# Dependencias y compilados (SOPI no usa, pero por si acaso)
node_modules/
dist/
build/

# Temporales
*.log
*.tmp
*.bak
*~

# Respaldos de datos exportados desde la app
sopi-*.json

# NOTA sobre js/config.js
# ------------------------------------------------------------
# SÍ se sube. Es necesario para que la web publicada sepa a qué
# proyecto de Supabase conectarse, y la clave "anon" está pensada
# para ir en el navegador (la protección real son las reglas RLS).
# Lo que NUNCA debe entrar aquí es la clave service_role.
